# Server Configuration
PORT=8080
GIN_MODE=debug

# Yandex Translate API Configuration
# Получить API ключ:
# 1. Зарегистрируйтесь на https://cloud.yandex.ru/
# 2. Создайте каталог (folder)
# 3. Создайте сервисный аккаунт с ролью ai.translate.user
# 4. Создайте API-ключ для сервисного аккаунта
# 5. Скопируйте Folder ID из консоли Yandex Cloud
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# CORS Configuration
# Разрешенные origins для CORS (разделенные запятой)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# Database (если будет использоваться)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=textropy
# DB_PASSWORD=textropy
# DB_NAME=textropy
